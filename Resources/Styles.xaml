<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base Theme -->
    <SolidColorBrush x:Key="Background" Color="#0D0D12" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="Foreground" Color="#E8E6F0" />
    <SolidColorBrush x:Key="Border" Color="#2E2E4A" />
    <SolidColorBrush x:Key="Accent" Color="#7B2FFF" />
    <SolidColorBrush x:Key="Divider" Color="#363655" />
    <SolidColorBrush x:Key="Muted" Color="#9896A8" />
    <SolidColorBrush x:Key="Success" Color="#2FFF8B" />
    <SolidColorBrush x:Key="Error" Color="#FF4572" />
    
    <!-- Card styling -->
    <SolidColorBrush x:Key="CardBackground" Color="#252542" />
    
    
    <!-- Button styling -->
    <SolidColorBrush x:Key="ButtonHover" Color="#9355FF" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#6518E6" />
    
    <Style x:Key="RoundedButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <!-- Hover event -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHover}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    
                        <!-- Click event -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>