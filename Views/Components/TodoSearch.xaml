<UserControl x:Class="TodoApp.Views.Components.TodoSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:TodoApp.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Text input -->
        <Border Grid.Column="0" CornerRadius="25" Background="{StaticResource Foreground}" HorizontalAlignment="Stretch"
                VerticalAlignment="Top" Margin="0 0 15 0">
            <TextBox Height="50" HorizontalAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Center"
                     materialDesign:HintAssist.Hint="Search by title" materialDesign:HintAssist.IsFloating="False" Foreground="{StaticResource Background}"
                     Background="Transparent" BorderThickness="0" Padding="10" TextWrapping="Wrap" FontSize="24"
                     Name="Input" KeyDown="Search_OnKeyDown" />
        </Border>

        <!-- Submit button -->
        <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Width="50" Height="50" Click="Search">
            <materialDesign:PackIcon Kind="Search" Width="24" Height="24" />
        </Button>
    </Grid>
</UserControl>
