<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
      <PackageReference Include="System.Text.Json" Version="10.0.6" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Fonts\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Fonts\Atma\Atma-Bold.ttf" />
      <Resource Include="Fonts\Atma\Atma-Bold.ttf" />
      <None Remove="Fonts\Atma\Atma-Light.ttf" />
      <Resource Include="Fonts\Atma\Atma-Light.ttf" />
      <None Remove="Fonts\Atma\Atma-Medium.ttf" />
      <Resource Include="Fonts\Atma\Atma-Medium.ttf" />
      <None Remove="Fonts\Atma\Atma-Regular.ttf" />
      <Resource Include="Fonts\Atma\Atma-Regular.ttf" />
      <None Remove="Fonts\Atma\Atma-SemiBold.ttf" />
      <Resource Include="Fonts\Atma\Atma-SemiBold.ttf" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Views\AIGenerated_Layout.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="Views\MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>
</Project>
