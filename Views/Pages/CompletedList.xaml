<UserControl x:Class="TodoApp.Views.Pages.CompletedList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TodoApp.Views.Components"
             xmlns:local="clr-namespace:TodoApp.Views.Pages"
             mc:Ignorable="d"
             d:DesignHeight="725" d:DesignWidth="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid Margin="0 0 0 25" Grid.Row="0">
            <views:TodoSearch SearchSubmitted="OnSearch" />
        </Grid>

        <Grid Grid.Row="1">
            <views:TodoPanel x:Name="TodoPanel"
                ItemsSource="{Binding CompletedTodos}"
                ShowDeleteButton="True"
                ShowRestoreButton="True"
                IsStrikethrough="True"
                TodoDeleted="OnTodoDeleted"
                TodoRestored="OnTodoRestored" />
        </Grid>
    </Grid>
</UserControl>
