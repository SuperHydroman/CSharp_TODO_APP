<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>1.0.0</Version>
        <ApplicationIcon>Resources\Images\Icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
      <PackageReference Include="System.Text.Json" Version="10.0.6" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Fonts\" />
      <Folder Include="Resources\Images\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Fonts\Atma\Atma-Bold.ttf" />
      <Resource Include="Fonts\Atma\Atma-Bold.ttf" />
      <None Remove="Fonts\Atma\Atma-Light.ttf" />
      <Resource Include="Fonts\Atma\Atma-Light.ttf" />
      <None Remove="Fonts\Atma\Atma-Medium.ttf" />
      <Resource Include="Fonts\Atma\Atma-Medium.ttf" />
      <None Remove="Fonts\Atma\Atma-Regular.ttf" />
      <Resource Include="Fonts\Atma\Atma-Regular.ttf" />
      <None Remove="Fonts\Atma\Atma-SemiBold.ttf" />
      <Resource Include="Fonts\Atma\Atma-SemiBold.ttf" />
      <None Remove="Resources\Images\Icon.ico" />
      <Resource Include="Resources\Images\Icon.ico" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Views\MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
        
      <Page Update="Resources\Styling\Buttons.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
        
      <Page Update="Resources\Styling\Theme.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
        
      <Page Update="Views\Pages\CompletedList.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
        
      <Page Update="Views\Pages\DeletedList.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
        
      <Page Update="Views\Components\TodoSearch.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>
</Project>
