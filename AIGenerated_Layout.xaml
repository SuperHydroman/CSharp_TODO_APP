<Window x:Class="TodoApp.AIGenerated_Layout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Todo App - Gideon van den Herik"
        MinHeight="800" Height="800" MaxHeight="800"
        MinWidth="450"  Width="450"  MaxWidth="450"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ============================================
             COLOR PALETTE
             ============================================ -->
        <Color x:Key="BaseDark">#0A0A0F</Color>
        <Color x:Key="CardDark">#12121A</Color>
        <Color x:Key="CardMid">#1A1A26</Color>
        <Color x:Key="Accent1">#6C5CE7</Color>
        <Color x:Key="Accent2">#A855F7</Color>
        <Color x:Key="Accent3">#38BDF8</Color>
        <Color x:Key="Glow">#806C5CE7</Color>
        <Color x:Key="TextPrimary">#F0F0F8</Color>
        <Color x:Key="TextSecondary">#6E6E80</Color>
        <Color x:Key="Success">#34D399</Color>
        <Color x:Key="Danger">#F87171</Color>

        <SolidColorBrush x:Key="BaseDarkBrush" Color="{StaticResource BaseDark}" />
        <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDark}" />
        <SolidColorBrush x:Key="CardMidBrush" Color="{StaticResource CardMid}" />
        <SolidColorBrush x:Key="Accent1Brush" Color="{StaticResource Accent1}" />
        <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

        <!-- Gradient for outer glow border -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Accent1}" Offset="0" />
            <GradientStop Color="{StaticResource Accent2}" Offset="0.5" />
            <GradientStop Color="{StaticResource Accent3}" Offset="1" />
        </LinearGradientBrush>

        <!-- Subtle gradient for cards -->
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1A26" Offset="0" />
            <GradientStop Color="#141420" Offset="1" />
        </LinearGradientBrush>

        <!-- Glass effect brush -->
        <LinearGradientBrush x:Key="GlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#30FFFFFF" Offset="0" />
            <GradientStop Color="#08FFFFFF" Offset="0.5" />
            <GradientStop Color="#15FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- ============================================
             CUSTOM SCROLLBAR
             ============================================ -->
        <Style x:Key="GlassScrollBar" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Margin="0 0 4 0" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Width="6"
                                       Margin="0 8">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border Background="#10FFFFFF" CornerRadius="3">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ThumbBorder"
                                                                        CornerRadius="3"
                                                                        MinHeight="30">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="{StaticResource Accent1}" Offset="0" />
                                                                            <GradientStop Color="{StaticResource Accent2}" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================
             ADD BUTTON STYLE
             ============================================ -->
        <Style x:Key="GlowAddButton" TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glow behind button -->
                            <Border x:Name="GlowBorder" CornerRadius="15" Opacity="0.4">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{StaticResource Accent1}" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="15" />
                                </Border.Effect>
                            </Border>
                            <!-- Button face -->
                            <Border x:Name="ButtonFace" CornerRadius="15">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Accent1}" Offset="0" />
                                        <GradientStop Color="{StaticResource Accent2}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonFace" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================
             CHECKBOX STYLE (Toggle circle)
             ============================================ -->
        <Style x:Key="TodoCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Ellipse x:Name="Outer" Width="28" Height="28"
                                     Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                     Fill="Transparent" />
                            <Ellipse x:Name="Inner" Width="16" Height="16"
                                     Fill="Transparent" />
                            <materialDesign:PackIcon x:Name="Check" Kind="Check"
                                                     Width="16" Height="16"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="Outer" Property="Fill">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource Success}" Offset="0" />
                                            <GradientStop Color="#2DD4BF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Accent2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================
             DELETE BUTTON
             ============================================ -->
        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"
                                                     Foreground="{StaticResource DangerBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#20F87171" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ============================================
         MAIN WINDOW CHROME
         ============================================ -->
    <Border CornerRadius="20" Background="{StaticResource BaseDarkBrush}"
            BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource Accent1}" BlurRadius="40"
                              ShadowDepth="0" Opacity="0.15" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================
                 TITLE BAR (draggable)
                 ============================================ -->
            <Grid Grid.Row="0" Margin="24 16 24 0" MouseLeftButtonDown="AIGenerated_Layout_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="22" Height="22"
                                             Foreground="{StaticResource Accent2Brush}" Margin="0 0 10 0"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="TODOS" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               FontFamily="/Fonts/Atma/#Atma" />
                    <TextBlock Text=" — Gideon" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="6 2 0 0" />
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                            Background="Transparent" BorderThickness="0" Width="30" Height="30"
                            Cursor="Hand" Click="MinimizeButton_OnClick" />
                    <Button Content="✕" FontSize="12" Foreground="{StaticResource DangerBrush}"
                            Background="Transparent" BorderThickness="0" Width="30" Height="30"
                            Cursor="Hand" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <!-- ============================================
                 HEADER / DATE
                 ============================================ -->
            <StackPanel Grid.Row="1" Margin="28 16 28 0">
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="/Fonts/Atma/#Atma">
                    <TextBlock.Text>
                        <Binding StringFormat="{}What's the plan?" />
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="Stay focused. Get it done. ✨" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0 2 0 0" />
            </StackPanel>

            <!-- ============================================
                 INPUT ROW
                 ============================================ -->
            <Grid Margin="24 20 24 0" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Glass input field -->
                <Border Grid.Column="0" CornerRadius="15" Margin="0 0 12 0"
                        Background="{StaticResource CardMidBrush}"
                        BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                    <TextBox Height="50" VerticalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             Padding="16 0" FontSize="15"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource Accent2Brush}"
                             FontFamily="/Fonts/Atma/#Atma"
                             Name="NewTodoTextBox"
                             KeyDown="NewTodoTextBox_OnKeyDown" />
                </Border>

                <!-- Add button with glow -->
                <Button Grid.Column="1" Style="{StaticResource GlowAddButton}"
                        Name="AddButton" Click="AddButton_OnClick">
                    <materialDesign:PackIcon Kind="Plus" Width="24" Height="24" Foreground="White" />
                </Button>
            </Grid>

            <!-- ============================================
                 TODO LIST PANEL
                 ============================================ -->
            <Grid Margin="24 20 24 24" Grid.Row="3">
                <!-- Outer card with glass border -->
                <Border CornerRadius="20"
                        Background="{StaticResource CardDarkBrush}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1"
                        Padding="10">

                    <ScrollViewer Style="{StaticResource GlassScrollBar}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Todos}" Name="TodoList">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0 0 0 8" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Todo card: 20 - 10 padding = 10 radius -->
                                    <Border x:Name="TodoCard" CornerRadius="10"
                                            Background="{StaticResource CardGradient}"
                                            BorderBrush="{StaticResource GlassBorder}"
                                            BorderThickness="1"
                                            Padding="14 16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource TodoCheckBox}"
                                                      IsChecked="{Binding IsCompleted}"
                                                      VerticalAlignment="Center" />

                                            <!-- Todo text -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="15"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="14 0 10 0"
                                                       FontFamily="/Fonts/Atma/#Atma" />

                                            <!-- Delete button -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource DeleteButton}"
                                                    VerticalAlignment="Center"
                                                    Click="DeleteButton_OnClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>