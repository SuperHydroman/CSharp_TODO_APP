<Window x:Class="TodoApp.Views.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TodoApp.Views.Components"
        mc:Ignorable="d"
        Icon="/Resources/Images/Icon.ico"
        Title="Todo App - Gideon van den Herik"
        MinHeight="800" Height="800" MaxHeight="800"
        MinWidth="450"  Width="450"  MaxWidth="450"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        Background="{StaticResource Background}"
        Foreground="{StaticResource Foreground}"
        FontFamily="/Fonts/Atma/#Atma">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="75" />
        </Grid.RowDefinitions>
        
        <ContentControl Margin="25" Grid.Row="0" x:Name="MainContent" />
            
        <Grid Grid.Row="1">
            <views:UserNav ViewChanged="OnViewChanged" />
        </Grid>
    </Grid>
</Window>